@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<nav class="nm-navbar">
    <a class="nm-brand" href="/" @onclick="CloseMenu">
        <span><LogoAnimation/></span>
    </a>

    <button class="nm-toggle" @onclick="ToggleMenu">
        <i class="bi bi-list"></i>
    </button>

    <div class="nm-menu @(isOpen ? "open" : "")" @onclick="CloseMenu">
        <AuthorizeView Context="auth">
            <Authorized>
                <div class="nm-links">
                    <NavLink class="nm-link" href="/activiteiten">Activiteiten</NavLink>
                    <NavLink class="nm-link" href="/mijn-inschrijvingen">Mijn inschrijvingen</NavLink>
                    <AuthorizeView Roles="Admin" Context="admin">
                        <NavLink class="nm-link" href="/activiteit/nieuw">Activiteit aanmaken</NavLink>
                    </AuthorizeView>
                </div>

                <button class="nm-button" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Uitloggen</span>
                </button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nm-button" href="/login">Inloggen</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private bool isOpen = false;

    private void ToggleMenu()
        => isOpen = !isOpen;

    private void CloseMenu()
        => isOpen = false;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}
