@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<header class="nm-header">
    @if (openDropdown is not null)
    {
        <div class="nm-backdrop" @onclick="CloseMenu"></div>
    }

    <nav class="nm-navbar @(hoverPaused ? "nm-hover-paused" : "")">
        <NavLink class="nm-brand" href="/" Match="NavLinkMatch.Prefix" @onclick="CloseMenu">
            <span>
                <LogoAnimation />
            </span>
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <button class="nm-toggle" @onclick="ToggleMenu">
                    <i class="bi bi-list"></i>
                </button>
            </Authorized>
        </AuthorizeView>

        <div class="nm-menu @(isOpen ? "open" : "")" @onclick="CloseMenu">
            <AuthorizeView>
                <Authorized>
                    <div class="nm-links">
                        <NavLink class="nm-link" href="/activiteiten" Match="NavLinkMatch.Prefix">Activiteiten</NavLink>
                        <NavLink class="nm-link" href="/kalender">Kalender</NavLink>
                    </div>
                    <div class="nm-dropdown @(openDropdown == "elo" ? "open" : "")" @onclick:stopPropagation @onmouseenter="@(() => HoverDropdown("elo"))" @onmouseleave="ResumeHover">
                        <button class="nm-link nm-dropdown-toggle" @onclick="@(() => ToggleDropdown("elo"))"> ELO-ranking <i class="bi bi-chevron-down"></i> </button>
                        <div class="nm-dropdown-menu">
                            <AuthorizeView Roles="Admin" Context="eloAdmin">
                                <NotAuthorized>
                                    <NavLink class="nm-dropdown-item" href="/categorieen" @onclick="ChoosePage"> Categorieen </NavLink>
                                </NotAuthorized>
                            </AuthorizeView>
                            <NavLink class="nm-dropdown-item" href="/ranglijst" @onclick="ChoosePage"> Ranglijst </NavLink>
                            <NavLink class="nm-dropdown-item" href="/statistieken" @onclick="ChoosePage"> Statistieken </NavLink>
                        </div>
                    </div>
                    <AuthorizeView Roles="Admin" Context="admin">
                        <div class="nm-dropdown @(openDropdown == "beheer" ? "open" : "")" @onclick:stopPropagation @onmouseenter="@(() => HoverDropdown("beheer"))" @onmouseleave="ResumeHover">
                            <button class="nm-link nm-dropdown-toggle" @onclick="@(() => ToggleDropdown("beheer"))"> Beheer <i class="bi bi-chevron-down"></i> </button>
                            <div class="nm-dropdown-menu">
                                <NavLink class="nm-dropdown-item" href="/activiteit/nieuw" @onclick="ChoosePage"> Activiteit aanmaken </NavLink>
                                <NavLink class="nm-dropdown-item" href="/gebruiker/nieuw" @onclick="ChoosePage"> Gebruiker aanmaken </NavLink>
                                <NavLink class="nm-dropdown-item" href="/categorieen" @onclick="ChoosePage"> ELO-categorieën </NavLink>
                                <NavLink class="nm-dropdown-item" href="/wedstrijd/nieuw" @onclick="ChoosePage"> Wedstrijd registreren </NavLink>
                            </div>
                        </div>
                    </AuthorizeView>
                    <div class="nm-account">
                        <NavLink class="nm-link" href="@($"/speler/{User.FindFirst("slug")?.Value ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty}")">
                            <i class="bi bi-person-circle"></i>
                            <span>Profiel</span>
                        </NavLink>
                        <button class="nm-button" @onclick="HandleLogout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Uitloggen</span>
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <NavLink class="nm-button nm-login" href="/login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Inloggen</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }
    ClaimsPrincipal User = new ClaimsPrincipal(new ClaimsIdentity());

    private bool isOpen = false;
    private string? openDropdown;
    private bool hoverPaused = false;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null)
            return;

        AuthenticationState authenticationState = await AuthenticationState;
        User = authenticationState.User;
    }

    private void ToggleMenu()
        => isOpen = !isOpen;

    private void CloseMenu()
    {
        isOpen = false;
        openDropdown = null;
    }

    private void ToggleDropdown(string name)
        => openDropdown = openDropdown == name ? null : name;

    private void ChoosePage()
    {
        hoverPaused = true;
        CloseMenu();
    }

    private void ResumeHover()
        => hoverPaused = false;

    private void HoverDropdown(string name)
    {
        if (openDropdown != name)
            openDropdown = null;
    }

    private async Task HandleLogout()
        => await AuthService.LogoutAsync();
}