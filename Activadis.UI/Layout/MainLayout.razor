@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
<div class="ml-page">
    <nav class="ml-sidebar">
        <NavLink href="/" style="text-decoration: none;" Match="NavLinkMatch.Prefix">
            <div class="ml-sidebar-brand">
                <img class="ml-brand-icon" src="/icon-192.png" />
                <span class="ml-brand-name">Activadis</span>
            </div>
        </NavLink>


        <AuthorizeView Context="auth">
            <Authorized>
                <div class="ml-navbar-links">
                    <h5>Main menu</h5>
                    
                </div>

                <button class="ml-logout-btn" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>LogOut</span>
                </button>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="ml-main-content">
        @Body
    </main>
</div>


@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}