@page "/login"
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<div class="login-page">
    <div class="login-circle login-circle-orange"></div>
    <div class="login-circle login-circle-blue"></div>

    <div class="login-wrapper">
        <div class="login-left">
            <div class="brand">
                <span class="logo">
                    <LogoAnimation />
                </span>
            </div>
        </div>

        <div class="login-right">
            <h1>Activadis</h1>
            <h2>Inloggen met e-mail</h2>
            <EditForm EditContext="form.Context" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">E-mailadres</label>
                    <InputText id="email"
                               class="form-control"
                               @bind-Value="request.Email"
                               type="email"
                               inputmode="email"
                               placeholder="naam@covadis.nl" />
                    <ValidationMessage For="@(() => request.Email)" />
                </div>

                <div class="form-group">
                    <label for="password">Wachtwoord</label>
                    <InputText id="password"
                               class="form-control"
                               @bind-Value="request.Password"
                               type="password"
                               placeholder="Wachtwoord" />
                    <ValidationMessage For="@(() => request.Password)" />
                </div>

                @if (form.FormError is not null)
                {
                    <p class="validation-message">@form.FormError</p>
                }

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Aan het laden...</span>
                    }
                    else
                    {
                        <span>Inloggen</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginRequest request = new LoginRequest();
    private ComponentRequest<LoginRequest> form = null!;
    private bool isLoading = false;

    protected override void OnInitialized()
        => form = new ComponentRequest<LoginRequest>(request);

    private async Task HandleLogin()
    {
        isLoading = true;

        ApiResponse<Token> response = await AuthService.LoginAsync(request);
        if (!response.Succeeded)
        {
            if (response.GetStatusCode() == 401)
                form.ShowFormError(response.Message ?? "Het e-mailadres of wachtwoord is onjuist.");
            else
                form.ShowErrors(response);

            isLoading = false;
            return;
        }

        NavigationManager.NavigateTo("/activiteiten");
        isLoading = false;
    }
}
