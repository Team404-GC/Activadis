@page "/login"
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<div class="login-page">
    <div class="login-circle login-circle-orange"></div>
    <div class="login-circle login-circle-blue"></div>

    <div class="login-wrapper">
        <div class="login-left">
            <div class="brand">
                <span class="logo">
                    <LogoAnimation />
                </span>
            </div>
        </div>

        <div class="login-right">
            <h1>Activadis</h1>
            <h2>Login</h2>
            <EditForm Model="request" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <InputText id="email"
                               class="form-control"
                               @bind-Value="request.Email"
                               inputmode="email"
                               placeholder="Email" />
                    <ValidationMessage For="@(() => request.Email)" />
                </div>

                <div class="form-group">
                    <InputText id="password"
                               class="form-control"
                               @bind-Value="request.Password"
                               type="password"
                               placeholder="Password" />
                    <ValidationMessage For="@(() => request.Password)" />
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Aan het laden...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginRequest request = new LoginRequest();
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;

        ApiResponse<Token> response = await AuthService.LoginAsync(request);
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isLoading = false;
            return;
        }

        NavigationManager.NavigateTo("/activiteiten");
        isLoading = false;
    }
}
