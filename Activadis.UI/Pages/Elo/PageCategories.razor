@inject IEloService EloService
@page "/categorieen"

<PageTitle>Categorieën</PageTitle>

<div class="ca-header">
    <h1>Categorieën</h1>
    @if (!isFormOpen)
    {
        <button type="button" class="ca-button" @onclick="OpenCreate">
            <i class="bi bi-plus-lg"></i>
            <span>Nieuwe categorie</span>
        </button>
    }
</div>

@if (isFormOpen)
{
    <CategoryFormComponent @key="formModel"
                           Model="formModel"
                           IsSaving="isSaving"
                           OnSubmit="SubmitAsync"
                           OnCancel="CloseForm" />
}

@if (isLoading)
{
    <div class="ca-state">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (hasFailed)
{
    <p class="ca-state">De categorieën konden niet worden geladen.</p>
}
else if (!categories.Any())
{
    <p class="ca-state">Er zijn nog geen categorieën.</p>
}
else
{
    <div class="ca-card">
        <table class="ca-table">
            <thead>
                <tr>
                    <th>Naam</th>
                    <th class="ca-hide-small">Beschrijving</th>
                    <th class="ca-hide-small">Volgorde</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (CategoryDto category in categories)
                {
                    <tr>
                        <td><NavLink class="ca-name" href="@($"/ranglijst?categorie={category.Id}")">@category.Name</NavLink></td>
                        <td class="ca-hide-small ca-muted">@category.Description</td>
                        <td class="ca-hide-small">@category.DisplayOrder</td>
                        <td>
                            <span class="ca-status @(category.IsActive ? "ca-status-active" : "ca-status-inactive")">
                                @(category.IsActive ? "Actief" : "Inactief")
                            </span>
                        </td>
                        <td class="ca-actions">
                            <button type="button" class="ca-button-secondary" @onclick="@(() => OpenEdit(category))">
                                <i class="bi bi-pencil"></i>
                                <span>Bewerken</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool isAdmin;

    private List<CategoryDto> categories = [];
    private bool isLoading = true;
    private bool hasFailed;

    private bool isFormOpen;
    private bool isSaving;
    private Guid? editingId;
    private CreateCategoryRequest formModel = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState;
        isAdmin = state.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        hasFailed = false;

        ApiResponse<List<CategoryDto>> response = await EloService.GetCategoriesAsync();
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            hasFailed = true;
            isLoading = false;
            return;
        }

        categories = response.Value ?? [];
        isLoading = false;
    }

    private void OpenCreate()
    {
        editingId = null;
        formModel = new CreateCategoryRequest()
        {
            IsActive = true,
            RankTitles = new Dictionary<double, string>()
            {
                [0] = "Beginner",
                [550] = "Amateur",
                [750] = "Gevorderde",
                [950] = "Expert",
                [1100] = "Meester"
            }
        };
        isFormOpen = true;
    }

    private void OpenEdit(CategoryDto category)
    {
        editingId = category.Id;
        formModel = new CreateCategoryRequest()
        {
            Name = category.Name,
            Description = category.Description,
            DisplayOrder = category.DisplayOrder,
            IsActive = category.IsActive,
            RankTitles = category.RankTitles != null ? new Dictionary<double, string>(category.RankTitles) : new()
        };
        isFormOpen = true;
    }

    private void CloseForm()
        => isFormOpen = false;

    private async Task SubmitAsync(CreateCategoryRequest model)
    {
        isSaving = true;

        ApiResponse<object> response;
        if (editingId is null)
        {
            response = await EloService.CreateCategoryAsync(new CreateCategoryRequest()
            {
                Name = model.Name,
                Description = model.Description,
                DisplayOrder = model.DisplayOrder,
                IsActive = model.IsActive,
                RankTitles = model.RankTitles
            });
        }
        else
        {
            ApiResponse<CategoryDto> updateResponse = await EloService.UpdateCategoryAsync(new UpdateCategoryRequest()
            {
                Id = editingId.Value,
                Name = model.Name,
                Description = model.Description,
                DisplayOrder = model.DisplayOrder,
                IsActive = model.IsActive,
                RankTitles = model.RankTitles
            });

            response = new ApiResponse<object>()
            {
                Succeeded = updateResponse.Succeeded,
                Message = updateResponse.Message
            };
        }

        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isSaving = false;
            return;
        }

        Notifications.AddNotification("De categorie is met succes opgeslagen.", false);
        isSaving = false;
        isFormOpen = false;

        await LoadAsync();
    }
}
