<h3 class="rt-heading">Rangtitels</h3>
<p class="rt-intro">Stel per minimale rating een rangtitel in, bijvoorbeeld "Brons" vanaf 800 en "Zilver" vanaf 1200.</p>

@if (RankTitles != null && RankTitles.Any())
{
    <ul class="rt-list">
        @foreach (var kvp in RankTitles.OrderBy(x => x.Key))
        {
            <li class="rt-item">
                <span class="rt-threshold">@kvp.Key.ToString("F0")+</span>
                <span class="rt-title">@kvp.Value</span>
                <button type="button" class="rt-remove" aria-label="@($"{kvp.Value} verwijderen")" @onclick="@(() => RemoveRankTitle(kvp.Key))">
                    <i class="bi bi-trash"></i>
                    <span>Verwijderen</span>
                </button>
            </li>
        }
    </ul>
}
else
{
    <p class="rt-empty">Er zijn nog geen rangtitels ingesteld.</p>
}

<div class="rt-add">
    <input class="rt-input rt-input-threshold" type="number" @bind="_newEloThreshold" placeholder="Minimale rating (bijv. 800)" />
    <input class="rt-input" type="text" @bind="_newRankTitle" placeholder="Titel (bijv. Brons)" />
    <button type="button" class="rt-button" @onclick="AddRankTitle">
        <i class="bi bi-plus-lg"></i>
        <span>Toevoegen</span>
    </button>
</div>

@code {
    [Parameter]
    public Dictionary<double, string> RankTitles { get; set; } = new();

    [Parameter]
    public EventCallback<Dictionary<double, string>> RankTitlesChanged { get; set; }

    private double _newEloThreshold;
    private string _newRankTitle = "";

    private async Task AddRankTitle()
    {
        if (_newEloThreshold < 0 || string.IsNullOrWhiteSpace(_newRankTitle))
        {
            return;
        }

        RankTitles[_newEloThreshold] = _newRankTitle;
        _newEloThreshold = 0;
        _newRankTitle = "";
        await RankTitlesChanged.InvokeAsync(RankTitles);
    }

    private async Task RemoveRankTitle(double threshold)
    {
        RankTitles.Remove(threshold);
        await RankTitlesChanged.InvokeAsync(RankTitles);
    }
}
