@inject NavigationManager NavigationManager
@inject IUserService UserService
@attribute [Authorize(Roles = "Admin")]
@page "/gebruikers/wijzigen/{Id}"

<PageTitle>Gebruiker wijzigen</PageTitle>

<div class="eu-page">
    <NavLink class="eu-back" href="/gebruikers">
        <i class="bi bi-arrow-left"></i>
        <span>Terug naar de gebruikers</span>
    </NavLink>

    <div class="eu-header">
        <h1>Gebruiker wijzigen</h1>
        @if (form is not null && !isActive)
        {
            <span class="eu-inactive">Inactief</span>
        }
    </div>

    @if (isLoading)
    {
        <div class="eu-state">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (form is null)
    {
        <p class="eu-state">Deze gebruiker is niet gevonden.</p>
    }
    else
    {
        <div class="eu-card">
            <EditForm EditContext="form.Context" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />

                <div class="eu-field">
                    <label for="fullName">Naam</label>
                    <InputText id="fullName" class="form-control" @bind-Value="request.FullName" />
                    <ValidationMessage For="@(() => request.FullName)" />
                </div>

                <div class="eu-field">
                    <label for="email">E-mail</label>
                    <InputText id="email" class="form-control" @bind-Value="request.Email" inputmode="email" />
                    <ValidationMessage For="@(() => request.Email)" />
                </div>

                <div class="eu-field">
                    <label for="jobTitle">Functie</label>
                    <InputSelect id="jobTitle" class="form-control" @bind-Value="request.JobTitle">
                        <option value="">Kies een functie</option>
                        @foreach (string jobTitle in JobTitles.All)
                        {
                            <option value="@jobTitle">@jobTitle</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => request.JobTitle)" />
                </div>

                <div class="eu-field">
                    <label for="role">Rol</label>
                    <InputSelect id="role" class="form-control" @bind-Value="request.Role">
                        <option value="User">Medewerker</option>
                        <option value="Admin">Beheerder</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => request.Role)" />
                </div>

                @if (form.FormError is not null)
                {
                    <p class="validation-message">@form.FormError</p>
                }

                <button type="submit" class="eu-button" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span>Aan het laden...</span>
                    }
                    else
                    {
                        <span>Opslaan</span>
                    }
                </button>
            </EditForm>
        </div>

        @if (request.Id != currentUserId)
        {
            <div class="eu-card">
                <h2 class="eu-card-title">Account</h2>
                <p class="eu-description">
                    @(isActive
                        ? "Een inactieve gebruiker kan niet meer inloggen en zich niet inschrijven voor activiteiten. Toekomstige inschrijvingen worden verwijderd."
                        : "Dit account is inactief. Na het activeren kan de gebruiker weer inloggen en zich inschrijven voor activiteiten.")
                </p>
                <button type="button" class="@(isActive ? "eu-button-danger" : "eu-button")" @onclick="UpdateStatusAsync" disabled="@isUpdatingStatus">
                    @if (isUpdatingStatus)
                    {
                        <span>Aan het laden...</span>
                    }
                    else
                    {
                        <span>@(isActive ? "Deactiveren" : "Activeren")</span>
                    }
                </button>
            </div>
        }
    }
</div>


@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    private UpdateUserRequest request = new UpdateUserRequest();
    private ComponentRequest<UpdateUserRequest>? form = null;
    private Guid currentUserId = Guid.Empty;
    private bool isActive = true;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isUpdatingStatus = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (AuthenticationState is not null)
        {
            AuthenticationState state = await AuthenticationState;
            if (!Guid.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out currentUserId))
                currentUserId = Guid.Empty;
        }

        ApiResponse<UserResponse> response = await UserService.GetByIdentifierAsync(Id);
        if (!response.Succeeded || response.Value is null)
        {
            Notifications.AddNotification(response.Message, true);
            isLoading = false;
            return;
        }

        request = new UpdateUserRequest()
        {
            Id = response.Value.Id,
            FullName = response.Value.FullName,
            Email = response.Value.Email,
            JobTitle = response.Value.JobTitle,
            Role = response.Value.Role
        };
        form = new ComponentRequest<UpdateUserRequest>(request);
        isActive = response.Value.IsActive;
        isLoading = false;
    }

    private async Task UpdateAsync()
    {
        isSaving = true;

        ApiResponse<object> response = await UserService.UpdateAsync(request);
        if (!response.Succeeded)
        {
            form?.ShowErrors(response);
            isSaving = false;
            return;
        }

        Notifications.AddNotification("De gebruiker is met succes bijgewerkt.", false);
        NavigationManager.NavigateTo("/gebruikers");
        isSaving = false;
    }

    private async Task UpdateStatusAsync()
    {
        isUpdatingStatus = true;

        ApiResponse<object> response = await UserService.UpdateStatusAsync(request.Id, new UpdateUserStatusRequest() { IsActive = !isActive });
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isUpdatingStatus = false;
            return;
        }

        isActive = !isActive;
        Notifications.AddNotification(isActive ? "De gebruiker is met succes geactiveerd." : "De gebruiker is met succes gedeactiveerd.", false);
        isUpdatingStatus = false;
    }
}
