<span class="ib">
    <button type="button" class="ib-button @(isOpen ? "active" : "")" aria-label="Meer informatie" @onclick="() => isOpen = !isOpen">
        <i class="bi bi-info-circle"></i>
    </button>
    @if (isOpen)
    {
        <small class="ib-text">@Text</small>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    private bool isOpen;
}
