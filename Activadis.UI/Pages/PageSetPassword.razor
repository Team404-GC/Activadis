@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@page "/wachtwoord-instellen/{Token}"

<PageTitle>Wachtwoord instellen</PageTitle>

<h1>Wachtwoord instellen</h1>

@if (isChecking)
{
    <div class="spinner-border" role="status"></div>
}
else if (linkError is not null)
{
    <p class="sp-intro">@linkError</p>
    <a class="sp-link" href="/login">Naar inloggen</a>
}
else
{
    <p class="sp-intro">Kies een wachtwoord voor je account. Daarna log je in met je e-mailadres.</p>

    <div class="sp-card">
        <EditForm EditContext="form.Context" OnValidSubmit="SetPasswordAsync">
            <DataAnnotationsValidator />

            <div class="sp-field">
                <label for="password">Wachtwoord</label>
                <InputText id="password" class="form-control" type="password" @bind-Value="request.Password" />
                <small class="sp-hint">Minimaal @SetPasswordRequest.MinPasswordLength tekens, met minstens 1 hoofdletter, 1 cijfer en 1 speciaal teken.</small>
                <ValidationMessage For="@(() => request.Password)" />
            </div>

            <div class="sp-field">
                <label for="confirmPassword">Wachtwoord herhalen</label>
                <InputText id="confirmPassword" class="form-control" type="password" @bind-Value="request.ConfirmPassword" />
                <ValidationMessage For="@(() => request.ConfirmPassword)" />
            </div>

            @if (form.FormError is not null)
            {
                <p class="validation-message">@form.FormError</p>
            }

            <button type="submit" class="sp-button" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Aan het laden...</span>
                }
                else
                {
                    <span>Wachtwoord instellen</span>
                }
            </button>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private SetPasswordRequest request = new SetPasswordRequest();
    private ComponentRequest<SetPasswordRequest> form = null!;
    private bool isChecking = true;
    private bool isLoading = false;
    private string? linkError;

    protected override async Task OnInitializedAsync()
    {
        form = new ComponentRequest<SetPasswordRequest>(request);

        if (string.IsNullOrWhiteSpace(Token))
        {
            linkError = "Deze link is niet meer geldig. Heb je je wachtwoord al ingesteld? Dan kun je inloggen. Lukt dat niet, neem dan contact op met een beheerder.";
            isChecking = false;
            return;
        }

        ApiResponse<object> response = await AuthService.CheckPasswordSetupAsync(Token);
        if (!response.Succeeded)
            linkError = response.Message ?? "Deze link is niet meer geldig. Heb je je wachtwoord al ingesteld? Dan kun je inloggen. Lukt dat niet, neem dan contact op met een beheerder.";

        isChecking = false;
    }

    private async Task SetPasswordAsync()
    {
        isLoading = true;
        request.Token = Token ?? string.Empty;

        ApiResponse<object> response = await AuthService.SetPasswordAsync(request);
        if (!response.Succeeded)
        {
            form.ShowErrors(response);
            isLoading = false;
            return;
        }

        Notifications.AddNotification("Je wachtwoord is ingesteld. Je kunt nu inloggen.", false);
        NavigationManager.NavigateTo("/login");
        isLoading = false;
    }
}
