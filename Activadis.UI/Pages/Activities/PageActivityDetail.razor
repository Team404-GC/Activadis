@using System.Globalization
@inject NavigationManager NavigationManager
@inject IActivityService ActivityService
@inject ISignUpService SignUpService
@inject IEloService EloService
@implements IDisposable
@page "/activiteit/{Id:guid}"

<PageTitle>@(activity?.Name ?? "Activiteit")</PageTitle>

<NavLink class="ad-back" href="@(User?.Identity?.IsAuthenticated == true ? "/activiteiten" : "/")" Match="NavLinkMatch.Prefix">
    <i class="bi bi-arrow-left"></i>
    <span>Terug naar activiteiten</span>
</NavLink>

@if (isLoading)
{
    <div class="ad-state">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (activity is null)
{
    <p class="ad-state">Deze activiteit is niet gevonden.</p>
}
else
{
    <div class="ad-header">
        <div class="ad-title">
            <h1>@activity.Name</h1>
            @if (activity.IsDraft)
            {
                <span class="ad-draft">Concept</span>
            }
        </div>
        @if (User?.IsInRole("Admin") ?? false)
        {
            <NavLink class="ad-edit" href="@($"/activiteit/bewerk/{Id}")">
                <i class="bi bi-pencil-fill"></i>
            </NavLink>
        }
    </div>
    <div class="ad-layout">
        <div class="ad-content">
            <div class="ad-status @(activity.IsOpenForSignUp ? "ad-status-open" : "ad-status-closed")">
                <i class="bi @(activity.IsOpenForSignUp ? "bi-check-circle" : "bi-x-circle")"></i>
                <span>@ToSignUpState(activity)</span>
            </div>

            <dl class="ad-facts">
                <dt>Datum en tijd</dt>
                <dd>@ToPeriod(activity)</dd>

                <dt>Locatie</dt>
                <dd>@activity.Location</dd>

                <dt>Kosten per persoon</dt>
                <dd>@ToCost(activity.CostPerPerson)</dd>

                <dt>Eten inbegrepen</dt>
                <dd>@ToAnswer(activity.FoodIncluded)</dd>

                <dt>Deelnemers</dt>
                <dd>@ToSpots(activity)</dd>
            </dl>

            <section class="ad-section">
                <h2>Beschrijving</h2>
                <p class="ad-description">@activity.Description</p>
            </section>

            @if (!string.IsNullOrWhiteSpace(activity.Requirements))
            {
                <section class="ad-section">
                    <h2>Benodigdheden</h2>
                    <p class="ad-description">@activity.Requirements</p>
                </section>
            }

            <section class="ad-section">
                <h2>Voorwaarden</h2>

                <dl class="ad-facts">
                    <dt>Minimaal aantal deelnemers</dt>
                    <dd>@(activity.MinParticipants > 0 ? activity.MinParticipants.ToString() : "Geen minimum")</dd>

                    <dt>Maximaal aantal deelnemers</dt>
                    <dd>@(activity.MaxParticipants > 0 ? activity.MaxParticipants.ToString() : "Geen maximum")</dd>

                    <dt>Externen toegestaan</dt>
                    <dd>@ToAnswer(activity.ExternalAllowed)</dd>

                    <dt>Introducé toegestaan</dt>
                    <dd>@ToAnswer(activity.PlusOneAllowed)</dd>

                    <dt>Inschrijven kan tot</dt>
                    <dd>@activity.SignUpDeadline.ToDisplayDateTime()</dd>

                    <dt>Uitschrijven kan tot</dt>
                    <dd>@activity.SignOutDeadline.ToDisplayDateTime()</dd>
                </dl>
            </section>

            <div class="ad-actions">
                @if (!activity.HasSignedUp || User?.Identity?.IsAuthenticated != true)
                {
                    <button class="ad-register" type="button" @onclick="@(() => OpenComponentAsync(signUpRequest))" disabled="@(!activity.IsOpenForSignUp || signUpRequest.IsLoading || editSignUpRequest.IsLoading || signOutRequest.IsLoading)">
                        @(!signUpRequest.IsLoading ? "Inschrijven" : "Aan het laden..")
                    </button>
                }
                @if (activity.HasSignedUp || User?.Identity?.IsAuthenticated != true)
                {
                    <button class="ad-register" type="button" @onclick="@(() => OpenComponentAsync(editSignUpRequest))" disabled="@(DateTime.UtcNow >= activity.SignOutDeadline || signUpRequest.IsLoading || editSignUpRequest.IsLoading || signOutRequest.IsLoading)">
                        @(!editSignUpRequest.IsLoading ? "Inschrijving wijzigen" : "Aan het laden..")
                    </button>
                    <button class="ad-register" type="button" @onclick="@(() => OpenComponentAsync(signOutRequest, SignOutAsync))" disabled="@(DateTime.UtcNow >= activity.SignOutDeadline || signUpRequest.IsLoading || editSignUpRequest.IsLoading || signOutRequest.IsLoading)">
                        @(!signOutRequest.IsLoading ? "Uitschrijven" : "Aan het laden..")
                    </button>
                }
            </div>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <section class="ad-section">
                    <h2>ELO-categorieën</h2>

                    @if (!activity.Categories.Any())
                    {
                        <p class="ad-empty">Er zijn geen ELO-categorieën gekoppeld aan deze activiteit.</p>
                    }
                    else
                    {
                        <div class="ad-elo-tags">
                            @foreach (CategoryDto category in activity.Categories)
                            {
                                <NavLink class="ad-elo-tag" href="@($"/ranglijst?categorie={category.Id}")">
                                    <i class="bi bi-trophy"></i>
                                    <span>@category.Name</span>
                                </NavLink>
                            }
                        </div>
                    }

                    @if (IsAdmin)
                    {
                        <div class="ad-elo-card">
                            <span class="ad-elo-card-title">Categorieën wijzigen</span>
                            <div class="ad-elo-options">
                                @foreach (CategoryDto category in SelectableCategories)
                                {
                                    <label class="ad-elo-option @(selectedCategoryIds.Contains(category.Id) ? "selected" : "")">
                                        <input type="checkbox" checked="@selectedCategoryIds.Contains(category.Id)" @onchange="@(args => OnCategoryChange(args, category.Id))" />
                                        <span>@category.Name</span>
                                    </label>
                                }
                            </div>
                            @if (categoryError is not null)
                            {
                                <p class="validation-message">@categoryError</p>
                            }
                            <button type="button" class="ad-elo-button-secondary" @onclick="SaveCategoriesAsync" disabled="@isSavingCategories">
                                @(!isSavingCategories ? "Categorieën opslaan" : "Aan het laden..")
                            </button>
                        </div>
                    }
                </section>

                <section class="ad-section">
                    <div class="ad-elo-header">
                        <h2>Wedstrijden</h2>
                        @if (IsAdmin)
                        {
                            <button type="button" class="ad-elo-button" @onclick="@(() => NavigationManager.NavigateTo($"/wedstrijd/nieuw?activiteit={Id}"))">
                                <i class="bi bi-plus-lg"></i>
                                <span>Wedstrijd aanmaken</span>
                            </button>
                        }
                    </div>

                    @if (!activity.Matches.Any())
                    {
                        <p class="ad-empty">Er zijn geen wedstrijden gekoppeld aan deze activiteit.</p>
                    }
                    else
                    {
                        <div class="ad-matches">
                            @foreach (RecentMatchDto match in activity.Matches)
                            {
                                <div class="ad-match">
                                    <div class="ad-match-header">
                                        <span class="ad-match-date">@match.MatchDate.ToDisplayDateTime()</span>
                                        <NavLink class="ad-match-category" href="@($"/ranglijst?categorie={match.CategoryId}")">@match.CategoryName</NavLink>
                                    </div>
                                    <ol class="ad-match-results">
                                        @foreach (RecentMatchParticipantDto participant in match.Participants)
                                        {
                                            <li class="ad-match-result">
                                                <span class="ad-match-placement @(participant.Placement == 1 ? "ad-match-winner" : "")">@participant.Placement</span>
                                                <NavLink class="ad-match-player" href="@($"/speler/{participant.UserId}")">@participant.FullName</NavLink>
                                                <span class="ad-match-change @ToChangeClass(participant.RatingChange)">@participant.RatingChange.ToRatingChange()</span>
                                            </li>
                                        }
                                    </ol>
                                    @if (IsAdmin)
                                    {
                                        <button type="button" class="ad-elo-button-danger" @onclick="@(() => UnlinkMatchAsync(match))" disabled="@isLinkingMatch">
                                            <i class="bi bi-link-45deg"></i>
                                            <span>Ontkoppelen</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (IsAdmin)
                    {
                        <div class="ad-elo-card">
                            <span class="ad-elo-card-title">Bestaande wedstrijd koppelen</span>
                            @if (matchError is not null)
                            {
                                <p class="validation-message">@matchError</p>
                            }
                            <div class="ad-elo-link">
                                <select class="ad-elo-select" @bind="selectedMatchId">
                                    <option value="@Guid.Empty">Kies een wedstrijd</option>
                                    @foreach (RecentMatchDto match in linkableMatches)
                                    {
                                        <option value="@match.MatchId">@ToMatchDescription(match)</option>
                                    }
                                </select>
                                <button type="button" class="ad-elo-button-secondary" @onclick="LinkMatchAsync" disabled="@isLinkingMatch">
                                    @(!isLinkingMatch ? "Wedstrijd koppelen" : "Aan het laden..")
                                </button>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>

        @if (activity.PhotoIds.Count > 0)
        {
            <aside class="ad-aside">
                <img class="ad-image" src="@ActivityService.GetPhotoUrl(activity.Id, activity.PhotoIds[0])" alt="@activity.Name" />
            </aside>
        }
    </div>

    <section class="ad-section">
        <h2>Foto's</h2>
        <PhotoCarouselComponent ActivityId="activity.Id" PhotoIds="activity.PhotoIds" Name="@activity.Name" />
    </section>

    <SignUpComponent PlusOneAllowed="activity.PlusOneAllowed"  @bind-Request="signUpRequest" OnSubmit="@(() => SubmitComponentAsync(signUpRequest, SignUpAsync))" />
    <EditSignUpComponent PlusOneAllowed="activity.PlusOneAllowed" @bind-Request="editSignUpRequest" OnSubmit="@(() => SubmitComponentAsync(editSignUpRequest, EditSignUpAsync))" />
    <SignOutComponent @bind-Request="signOutRequest" OnSubmit="@(() => SubmitComponentAsync(signOutRequest, SignOutAsync))" />
}

@code {
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    private ClaimsPrincipal? User { get; set; }

    [Parameter] public Guid Id { get; set; }

    private ActivityDetailResponse? activity;
    private bool isLoading = true;

    private ComponentRequest<SignUpRequest> signUpRequest = new ComponentRequest<SignUpRequest>(new SignUpRequest());
    private ComponentRequest<SignOutRequest> signOutRequest = new ComponentRequest<SignOutRequest>(new SignOutRequest());
    private ComponentRequest<EditSignUpRequest> editSignUpRequest = new ComponentRequest<EditSignUpRequest>(new EditSignUpRequest());

    private List<CategoryDto> activeCategories = [];
    private List<Guid> selectedCategoryIds = [];
    private bool isSavingCategories = false;
    private string? categoryError;

    private List<RecentMatchDto> linkableMatches = [];
    private Guid selectedMatchId = Guid.Empty;
    private bool isLinkingMatch = false;
    private string? matchError;

    private bool IsAdmin => User?.IsInRole("Admin") == true;

    private IEnumerable<CategoryDto> SelectableCategories
        => activeCategories
            .Concat(activity?.Categories.Where(x => !activeCategories.Any(y => y.Id == x.Id)) ?? [])
            .OrderBy(x => x.DisplayOrder);

    protected override async Task OnInitializedAsync()
    {
        await OnParametersSetAsync();

        isLoading = true;
        activity = null;

        ApiResponse<ActivityDetailResponse> response = await ActivityService.GetDetailAsync(Id);
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isLoading = false;
            return;
        }

        signUpRequest.Request.ActivityId = Id;
        signOutRequest.Request.ActivityId = Id;
        editSignUpRequest.Request.ActivityId = Id;

        activity = response.Value;
        if (activity is not null && !activity.ExternalAllowed && User?.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (activity is not null && IsAdmin)
            await LoadAdminDataAsync();

        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        AuthenticationState state = await AuthenticationState;
        User = state.User;

        if (activity is null || activity.ExternalAllowed == true || User?.Identity?.IsAuthenticated == true)
            return;

        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        signUpRequest.Dispose();
        editSignUpRequest.Dispose();
        signOutRequest.Dispose();
    }

    private async Task LoadAdminDataAsync()
    {
        if (activity is null)
            return;

        selectedCategoryIds = activity.Categories.Select(x => x.Id).ToList();

        ApiResponse<List<CategoryDto>> categoryResponse = await EloService.GetCategoriesAsync();
        if (!categoryResponse.Succeeded)
        {
            Notifications.AddNotification(categoryResponse.Message, true);
            return;
        }

        activeCategories = categoryResponse.Value ?? [];

        await LoadLinkableMatchesAsync();
    }

    private async Task LoadLinkableMatchesAsync()
    {
        ApiResponse<IEnumerable<RecentMatchDto>> response = await ActivityService.GetLinkableMatchesAsync(Id);
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            return;
        }

        linkableMatches = response.Value?.ToList() ?? [];
        selectedMatchId = Guid.Empty;
    }

    private async Task ReloadActivityAsync()
    {
        ApiResponse<ActivityDetailResponse> response = await ActivityService.GetDetailAsync(Id);
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            return;
        }

        activity = response.Value;
        await LoadAdminDataAsync();
    }

    public void OnCategoryChange(ChangeEventArgs args, Guid categoryId)
    {
        if (args.Value is true)
            selectedCategoryIds.Add(categoryId);
        else
            selectedCategoryIds.Remove(categoryId);
    }

    public async Task SaveCategoriesAsync()
    {
        isSavingCategories = true;

        UpdateActivityCategoriesRequest request = new UpdateActivityCategoriesRequest()
        {
            CategoryIds = selectedCategoryIds
        };

        categoryError = null;
        ApiResponse<object> response = await ActivityService.UpdateCategoriesAsync(Id, request);
        if (!response.Succeeded)
        {
            categoryError = response.HandleError();
            isSavingCategories = false;
            return;
        }

        await ReloadActivityAsync();
        Notifications.AddNotification("De ELO-categorieën zijn met succes opgeslagen.", false);
        isSavingCategories = false;
    }

    public async Task LinkMatchAsync()
    {
        matchError = null;
        if (selectedMatchId == Guid.Empty)
        {
            matchError = "Kies eerst een wedstrijd.";
            return;
        }

        isLinkingMatch = true;

        ApiResponse<object> response = await ActivityService.LinkMatchAsync(Id, new LinkMatchRequest() { MatchId = selectedMatchId });
        if (!response.Succeeded)
        {
            matchError = response.HandleError();
            isLinkingMatch = false;
            return;
        }

        await ReloadActivityAsync();
        Notifications.AddNotification("De wedstrijd is met succes gekoppeld.", false);
        isLinkingMatch = false;
    }

    public async Task UnlinkMatchAsync(RecentMatchDto match)
    {
        isLinkingMatch = true;

        matchError = null;
        ApiResponse<object> response = await ActivityService.UnlinkMatchAsync(Id, match.MatchId);
        if (!response.Succeeded)
        {
            matchError = response.HandleError();
            isLinkingMatch = false;
            return;
        }

        await ReloadActivityAsync();
        Notifications.AddNotification("De wedstrijd is met succes ontkoppeld.", false);
        isLinkingMatch = false;
    }

    public async Task OpenComponentAsync<TRequest>(ComponentRequest<TRequest> request, Func<Task>? action = null)
    {
        if (activity is null)
            return;

        request.FormError = null;

        if (typeof(TRequest) != typeof(SignOutRequest) || action is null || User?.Identity?.IsAuthenticated == false)
        {
            request.ShouldOpenComponent = true;
            return;
        }

        await action();
    }

    public async Task SubmitComponentAsync<TRequest>(ComponentRequest<TRequest> request, Func<Task> action)
    {
        request.ShouldOpenComponent = false;
        await action();
    }

    public async Task SignUpAsync()
    {
        if (activity is null)
            return;

        signUpRequest.IsLoading = true;
        ApiResponse<object> response = await SignUpService.SignUpAsync(signUpRequest.Request);
        if (!response.Succeeded)
        {
            signUpRequest.ShouldOpenComponent = response.IsInputError();
            signUpRequest.IsLoading = false;
            signUpRequest.ShowErrors(response);
            return;
        }

        if (User?.Identity?.IsAuthenticated == true)
        {
            editSignUpRequest.Request.Comment = signUpRequest.Request.Comment;
            editSignUpRequest.Request.HasPlusOne = signUpRequest.Request.HasPlusOne;

            activity.AvailableSpots--;
            activity.TotalSignUps++;
            activity.HasSignedUp = true;
            activity.IsFull = activity.HasParticipantLimit && activity.AvailableSpots <= 0;
            activity.IsOpenForSignUp = DateTime.UtcNow < activity.SignUpDeadline && !activity.IsFull;
            Notifications.AddNotification("Je bent succesvol ingeschreven bij deze activiteit.", false);
        }
        else
        {
            Notifications.AddNotification("We hebben een e-mail naar je verstuurd om de inschrijving te bevestigen.", false);
        }

        signUpRequest.Request = new SignUpRequest() { ActivityId = activity.Id };
        signUpRequest.IsLoading = false;
    }

    public async Task EditSignUpAsync()
    {
        if (activity is null)
            return;

        editSignUpRequest.IsLoading = true;
        ApiResponse<object> response = await SignUpService.EditSignUpAsync(editSignUpRequest.Request);
        if (!response.Succeeded)
        {
            editSignUpRequest.ShouldOpenComponent = response.IsInputError();
            editSignUpRequest.IsLoading = false;
            editSignUpRequest.ShowErrors(response);
            return;
        }

        if (User?.Identity?.IsAuthenticated == true)
        {
            Notifications.AddNotification("Je hebt je inschrijving succesvol bijgewerkt.", false);
        }
        else
        {
            editSignUpRequest.Request = new EditSignUpRequest() { ActivityId = activity.Id };
            Notifications.AddNotification("We hebben een e-mail naar je verstuurd om de wijziging te bevestigen.", false);
        }

        editSignUpRequest.IsLoading = false;
    }

    public async Task SignOutAsync()
    {
        if (activity is null)
            return;

        signOutRequest.IsLoading = true;
        ApiResponse<object> response = await SignUpService.SignOutAsync(signOutRequest.Request);
        if (!response.Succeeded)
        {
            signOutRequest.ShouldOpenComponent = response.IsInputError();
            signOutRequest.IsLoading = false;
            signOutRequest.ShowErrors(response);
            return;
        }

        if (User?.Identity?.IsAuthenticated == true)
        {
            activity.AvailableSpots++;
            activity.TotalSignUps--;
            activity.HasSignedUp = false;
            activity.IsFull = activity.HasParticipantLimit && activity.AvailableSpots <= 0;
            activity.IsOpenForSignUp = DateTime.UtcNow < activity.SignUpDeadline && !activity.IsFull;
            Notifications.AddNotification("Je bent succesvol uitgeschreven bij deze activiteit.", false);
        }
        else
        {
            Notifications.AddNotification("We hebben een e-mail naar je verstuurd om de uitschrijving te bevestigen.", false);
        }

        editSignUpRequest.Request = new EditSignUpRequest() { ActivityId = activity.Id };
        signOutRequest.Request = new SignOutRequest() { ActivityId = activity.Id };
        signOutRequest.IsLoading = false;
    }

    private static string ToPeriod(ActivityDetailResponse activity)
        => DateExtensions.ToDisplayPeriod(activity.StartDate, activity.EndDate);

    private static string ToCost(decimal cost)
        => cost <= 0
            ? "Gratis"
            : cost.ToString("C", CultureInfo.GetCultureInfo("nl-NL"));

    private static string ToSpots(ActivityDetailResponse activity)
        => activity.HasParticipantLimit
            ? $"{activity.TotalSignUps} van {activity.MaxParticipants} plekken bezet, nog {activity.AvailableSpots} beschikbaar"
            : $"{activity.TotalSignUps} aanmeldingen";

    private static string ToAnswer(bool value)
        => value ? "Ja" : "Nee";

    private static string ToChangeClass(double change)
        => change > 0 ? "ad-positive" : change < 0 ? "ad-negative" : string.Empty;

    private static string ToMatchDescription(RecentMatchDto match)
        => $"{match.MatchDate.ToDisplayDateTime()} - {match.CategoryName} - {string.Join(", ", match.Participants.Select(x => $"{x.Placement}. {x.FullName}"))}";

    private static string ToSignUpState(ActivityDetailResponse activity)
    {
        if (activity.IsOpenForSignUp)
            return "Inschrijving geopend";

        if (activity.HasTakenPlace)
            return "Deze activiteit heeft al plaatsgevonden.";

        if (activity.IsFull)
            return "Deze activiteit is volgeboekt.";

        if (!activity.HasSignedUp && activity.SignUpDeadlinePassed)
            return "De inschrijftermijn is verstreken.";

        if (activity.HasSignedUp && DateTime.UtcNow >= activity.SignOutDeadline)
            return "De uitschrijftermijn is verstreken.";

        return "Inschrijving gesloten.";
    }
}