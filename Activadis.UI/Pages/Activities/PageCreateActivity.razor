@inject IActivityService ActivityService
@inject IEloService EloService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]
@page "/activiteit/nieuw"

<PageTitle>Nieuwe activiteit</PageTitle>

<NavLink class="af-back" href="/activiteiten">
    <i class="bi bi-arrow-left"></i>
    <span>Terug naar activiteiten</span>
</NavLink>

@if (isLoading)
{
    <div class="af-state">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (context is not null)
{
    <h1 class="af-title">Creëer activiteit</h1>
    <EditForm EditContext="context" OnValidSubmit="CreateAsync" class="af-layout">
        <DataAnnotationsValidator />
        <div class="af-main">
            <section class="af-card">
                <h2 class="af-card-title"><i class="bi bi-card-text"></i>Algemeen</h2>
                <div class="af-grid">
                    <div class="af-field af-wide">
                        <label>Naam</label>
                        <InputText @bind-Value="request.Name" />
                        <ValidationMessage For="@(() => request.Name)" />
                    </div>
                    <div class="af-field af-wide">
                        <label>Beschrijving</label>
                        <InputTextArea rows="5" @bind-Value="request.Description" />
                        <ValidationMessage For="@(() => request.Description)" />
                    </div>
                    <div class="af-field af-wide">
                        <label>Benodigdheden <span class="af-optional">(optioneel)</span></label>
                        <InputTextArea rows="3" @bind-Value="request.Requirements" />
                        <ValidationMessage For="@(() => request.Requirements)" />
                    </div>
                    <div class="af-field">
                        <label>Locatie</label>
                        <InputText @bind-Value="request.Location" />
                        <ValidationMessage For="@(() => request.Location)" />
                    </div>
                    <div class="af-field">
                        <label>Kosten per persoon</label>
                        <div class="af-affix">
                            <span>€</span>
                            <InputNumber step="0.01" min="0" @bind-Value="request.CostPerPerson" />
                        </div>
                        <ValidationMessage For="@(() => request.CostPerPerson)" />
                    </div>
                </div>
            </section>

            <section class="af-card">
                <h2 class="af-card-title"><i class="bi bi-calendar-event"></i>Planning</h2>
                <div class="af-grid">
                    <div class="af-field">
                        <label>Startdatum</label>
                        <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.StartDate))" value="@(GetDateValue(x => x.StartDate))" />
                        <ValidationMessage For="@(() => request.StartDate)" />
                    </div>
                    <div class="af-field">
                        <label>Einddatum</label>
                        <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.EndDate))" value="@(GetDateValue(x => x.EndDate))" />
                        <ValidationMessage For="@(() => request.EndDate)" />
                    </div>
                    <div class="af-field">
                        <label>Inschrijfdeadline</label>
                        <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.SignUpDeadline))" value="@(GetDateValue(x => x.SignUpDeadline))" />
                        <ValidationMessage For="@(() => request.SignUpDeadline)" />
                    </div>
                    <div class="af-field">
                        <label>Uitschrijfdeadline</label>
                        <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.SignOutDeadline))" value="@(GetDateValue(x => x.SignOutDeadline))" />
                        <ValidationMessage For="@(() => request.SignOutDeadline)" />
                    </div>
                </div>
            </section>

            <section class="af-card">
                <h2 class="af-card-title"><i class="bi bi-people"></i>Deelnemers</h2>
                <div class="af-grid">
                    <div class="af-field">
                        <label>Minimaal aantal deelnemers</label>
                        <InputNumber @bind-Value="request.MinParticipants" />
                        <ValidationMessage For="@(() => request.MinParticipants)" />
                    </div>
                    <div class="af-field">
                        <label>Maximaal aantal deelnemers</label>
                        <InputNumber @bind-Value="request.MaxParticipants" />
                        <ValidationMessage For="@(() => request.MaxParticipants)" />
                    </div>
                </div>
                <div class="af-toggles">
                    <div class="af-toggle">
                        <span>Bevat eten & drinken?</span>
                        <label class="switch">
                            <InputCheckbox @bind-Value="request.FoodIncluded" />
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <div class="af-toggle">
                        <span>Is een externe activiteit?</span>
                        <label class="switch">
                            <InputCheckbox @bind-Value="request.ExternalAllowed" />
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <div class="af-toggle">
                        <span>Mag +1 meenemen?</span>
                        <label class="switch">
                            <InputCheckbox @bind-Value="request.PlusOneAllowed" />
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <aside class="af-side">
            <section class="af-card af-publish">
                <h2 class="af-card-title"><i class="bi bi-send"></i>Publiceren</h2>
                <div class="af-toggle">
                    <span>Opslaan als concept</span>
                    <label class="switch">
                        <InputCheckbox @bind-Value="request.IsDraft" />
                        <span class="slider round"></span>
                    </label>
                </div>
                <ValidationMessage For="@(() => request.IsDraft)" />
                @if (form?.FormError is not null)
                {
                    <p class="validation-message">@form?.FormError</p>
                }
                <button type="submit" class="af-submit" disabled="@isCreating">
                    @(!isCreating ? "Aanmaken" : "Aan het laden..")
                </button>
            </section>

            <section class="af-card">
                <h2 class="af-card-title">
                    <i class="bi bi-images"></i>Foto's
                    <InfoBubbleComponent Text="@($"Optioneel. Kies alle foto's in één keer, maximaal {ApplicationConfiguration.MaxPhotos}. De eerste foto komt op het kaartje.")" />
                </h2>
                <label class="af-dropzone">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <span>Kies foto's</span>
                    <small>PNG, JPG of WEBP</small>
                    <InputFile OnChange="OnFilesChange" accept="image/png,image/jpeg,image/webp" multiple />
                </label>
                @if (request.Photos.Count > 0)
                {
                    <ol class="af-files">
                        @for (int index = 0; index < request.Photos.Count; index++)
                        {
                            int current = index;
                            <li class="af-file">
                                <span class="af-file-index">@(current + 1)</span>
                                <span class="af-file-name">@request.Photos[current].Name</span>
                                <div class="af-file-actions">
                                    <button type="button" class="af-icon-button" title="Omhoog" disabled="@(current == 0)" @onclick="() => MovePhoto(current, -1)"><i class="bi bi-arrow-up"></i></button>
                                    <button type="button" class="af-icon-button" title="Omlaag" disabled="@(current == request.Photos.Count - 1)" @onclick="() => MovePhoto(current, 1)"><i class="bi bi-arrow-down"></i></button>
                                    <button type="button" class="af-icon-button af-icon-danger" title="Verwijderen" @onclick="() => RemovePhoto(current)"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="af-card">
                <h2 class="af-card-title">
                    <i class="bi bi-trophy"></i>ELO-categorieën
                    <InfoBubbleComponent Text="Optioneel. Kies de ELO-categorieën waarvoor wedstrijden op deze activiteit meetellen." />
                </h2>
                @if (categories.Count == 0)
                {
                    <p class="af-empty">Er zijn nog geen ELO-categorieën.</p>
                }
                else
                {
                    <div class="af-chips">
                        @foreach (CategoryDto category in categories)
                        {
                            <label class="af-chip @(request.CategoryIds.Contains(category.Id) ? "selected" : "")">
                                <input type="checkbox" checked="@request.CategoryIds.Contains(category.Id)" @onchange="@(args => OnCategoryChange(args, category.Id))" />
                                <span>@category.Name</span>
                            </label>
                        }
                    </div>
                }
                <ValidationMessage For="@(() => request.CategoryIds)" />
            </section>
        </aside>
    </EditForm>
}


@code {
    CreateActivityRequest request = new CreateActivityRequest();
    List<CategoryDto> categories = [];
    EditContext? context = null;
    ComponentRequest<CreateActivityRequest>? form = null;
    ValidationMessageStore? dateMessages = null;
    Dictionary<string, string> typedDates = [];
    bool isCreating = false;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        ApiResponse<List<CategoryDto>> response = await EloService.GetCategoriesAsync();
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isLoading = false;
            return;
        }

        categories = response.Value ?? [];
        form = new ComponentRequest<CreateActivityRequest>(request);
        context = form.Context;
        dateMessages = new ValidationMessageStore(context);
        isLoading = false;
    }

    public void OnCategoryChange(ChangeEventArgs args, Guid categoryId)
    {
        if (args.Value is true)
            request.CategoryIds.Add(categoryId);
        else
            request.CategoryIds.Remove(categoryId);

        context?.NotifyFieldChanged(new FieldIdentifier(request, nameof(request.CategoryIds)));
    }

    public void OnFilesChange(InputFileChangeEventArgs args)
    {
        if (args.FileCount > ApplicationConfiguration.MaxPhotos)
        {
            Notifications.AddNotification($"Je kunt maximaal {ApplicationConfiguration.MaxPhotos} foto's kiezen.", true);
            return;
        }

        List<IBrowserFile> photos = args.GetMultipleFiles(ApplicationConfiguration.MaxPhotos).ToList();
        if (photos.Sum(x => x.Size) > ApplicationConfiguration.AllowedSizeInMB)
        {
            Notifications.AddNotification($"De foto's zijn samen groter dan {ApplicationConfiguration.AllowedSizeInMB / 1024 / 1024} MB. Kies minder of kleinere foto's.", true);
            return;
        }

        request.Photos = photos;
    }

    public void MovePhoto(int index, int step)
        => (request.Photos[index], request.Photos[index + step]) = (request.Photos[index + step], request.Photos[index]);

    public void RemovePhoto(int index)
        => request.Photos.RemoveAt(index);

    public void OnDateChange(ChangeEventArgs args, Expression<Func<CreateActivityRequest, DateTime>> selector)
    {
        if (selector.Body is not MemberExpression expression || expression.Member is not PropertyInfo property || context is null || dateMessages is null)
            return;

        string text = args.Value?.ToString() ?? string.Empty;
        FieldIdentifier field = new FieldIdentifier(request, property.Name);
        dateMessages.Clear(field);

        if (DateExtensions.TryParseInput(text, out DateTime date))
        {
            typedDates.Remove(property.Name);
            property.SetValue(request, DateTime.SpecifyKind(date, DateTimeKind.Local).ToUniversalTime());
        }
        else
        {
            typedDates[property.Name] = text;
            property.SetValue(request, DateTime.MinValue);

            if (!string.IsNullOrWhiteSpace(text))
                dateMessages.Add(field, "Deze datum kan niet gelezen worden. Typ bijvoorbeeld 12-10-2026 19:30.");
        }

        context.NotifyFieldChanged(field);
        context.NotifyValidationStateChanged();
    }

    public string GetDateValue(Expression<Func<CreateActivityRequest, DateTime>> selector)
    {
        if (selector.Body is MemberExpression expression && typedDates.TryGetValue(expression.Member.Name, out string? text))
            return text;

        DateTime date = selector.Compile()(request);
        return date == DateTime.MinValue ? string.Empty : date.ToDisplayDateTime();
    }

    public async Task CreateAsync()
    {
        isCreating = true;

        CreateActivityRequest realRequest = new CreateActivityRequest();
        foreach (PropertyInfo property in typeof(CreateActivityRequest).GetProperties())
        {
            object? value = property.GetValue(request);
            if (property.PropertyType == typeof(decimal?))
                value = value == null ? 0.0m : value;

            if (property.PropertyType == typeof(int?))
                value = value == null ? 0 : value;

            property.SetValue(realRequest, value);
        }

        ApiResponse<object> response = await ActivityService.CreateAsync(realRequest);
        if (!response.Succeeded)
        {
            form?.ShowErrors(response);
            isCreating = false;
            return;
        }

        Notifications.AddNotification("De activiteit is met succes aangemaakt.", false);
        NavigationManager.NavigateTo("/");
        isCreating = false;
    }
}
