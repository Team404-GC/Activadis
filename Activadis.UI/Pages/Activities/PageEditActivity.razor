@inject NavigationManager NavigationManager
@inject IActivityService ActivityService
@attribute [Authorize(Roles = "Admin")]
@page "/activiteit/bewerk/{Id}"

<NavLink class="ad-back" href="@($"/activiteit/{activity?.Slug ?? Id}")" Match="NavLinkMatch.Prefix">
    <i class="bi bi-arrow-left"></i>
    <span>Terug naar de activiteit</span>
</NavLink>

@if (isLoading)
{
    <div class="ad-state">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (activity is null)
{
    <p class="ad-state">Deze activiteit is niet gevonden.</p>
}
else if (context is not null)
{
    <div class="form-container">
        <h3>Bewerk activiteit: @request.Name</h3>
        <EditForm EditContext="context" OnValidSubmit="EditAsync">
            <DataAnnotationsValidator />
            <section>
                <label>Naam</label>
                <InputText @bind-Value="request.Name" />
                <ValidationMessage For="@(() => request.Name)" />
            </section>
            <section>
                <label>Beschrijving</label>
                <InputTextArea @bind-Value="request.Description" />
                <ValidationMessage For="@(() => request.Description)" />
            </section>
            <section>
                <label>Benodigdheden (optioneel)</label>
                <InputTextArea @bind-Value="request.Requirements" />
                <ValidationMessage For="@(() => request.Requirements)" />
            </section>
            <section>
                <label>Kosten per persoon</label>
                <InputNumber step="0.01" @bind-Value="request.CostPerPerson" />
                <ValidationMessage For="@(() => request.CostPerPerson)" />
            </section>
            <br />
            <section>
                <label>Locatie</label>
                <InputText @bind-Value="request.Location" />
                <ValidationMessage For="@(() => request.Location)" />
            </section>
            <br />
            <section>
                <label>Minimaal aantal deelnemers</label>
                <InputNumber @bind-Value="request.MinParticipants" />
                <ValidationMessage For="@(() => request.MinParticipants)" />
            </section>
            <section>
                <label>Maximaal aantal deelnemers</label>
                <InputNumber @bind-Value="request.MaxParticipants" />
                <ValidationMessage For="@(() => request.MaxParticipants)" />
            </section>
            <br />
            <section>
                <label>Bevat eten & drinken?</label>
                <label class="switch">
                    <InputCheckbox @bind-Value="request.FoodIncluded" />
                    <span class="slider round"></span>
                </label>
                <ValidationMessage For="@(() => request.FoodIncluded)" />
            </section>
            <br />
            <section>
                <label>Startdatum</label>
                <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.StartDate))" value="@(GetDateValue(x => x.StartDate))" />
                <ValidationMessage For="@(() => request.StartDate)" />
            </section>
            <section>
                <label>Einddatum</label>
                <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.EndDate))" value="@(GetDateValue(x => x.EndDate))" />
                <ValidationMessage For="@(() => request.EndDate)" />
            </section>
            <br />
            <section>
                <label>Inschrijfdeadline</label>
                <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.SignUpDeadline))" value="@(GetDateValue(x => x.SignUpDeadline))" />
                <ValidationMessage For="@(() => request.SignUpDeadline)" />
            </section>
            <section>
                <label>Uitschrijfdeadline</label>
                <input type="text" placeholder="bijv. 12-10-2026 19:30" @onchange="@(args => OnDateChange(args, x => x.SignOutDeadline))" value="@(GetDateValue(x => x.SignOutDeadline))" />
                <ValidationMessage For="@(() => request.SignOutDeadline)" />
            </section>
            <br />
            <section>
                <label>Is draft?</label>
                <label class="switch">
                    <InputCheckbox @bind-Value="request.IsDraft" />
                    <span class="slider round"></span>
                </label>
                <ValidationMessage For="@(() => request.IsDraft)" />
                <button type="submit" disabled="@isEditing">Bewerken</button>
            </section>
            @if (form?.FormError is not null)
            {
                <p class="validation-message">@form?.FormError</p>
            }
        </EditForm>

        <div class="form-photo-manager">
            <h4>
                Foto's
                <InfoBubbleComponent Text="@($"Wijzigingen aan foto's worden direct opgeslagen. De eerste foto staat op het kaartje. Maximaal {ApplicationConfiguration.MaxPhotos} foto's.")" />
            </h4>
            @if (photoIds.Count == 0)
            {
                <p>Deze activiteit heeft nog geen foto's.</p>
            }
            else
            {
                <ol class="form-photos">
                    @for (int index = 0; index < photoIds.Count; index++)
                    {
                        int current = index;
                        Guid photoId = photoIds[current];
                        <li class="form-photo">
                            <img class="form-photo-preview" src="@ActivityService.GetPhotoUrl(activity?.Id ?? Guid.Empty, photoId)" alt="Foto @(current + 1)" />
                            <button type="button" title="Omhoog" disabled="@(current == 0 || isSavingPhotos)" @onclick="() => MovePhotoAsync(current, -1)"><i class="bi bi-arrow-up"></i></button>
                            <button type="button" title="Omlaag" disabled="@(current == photoIds.Count - 1 || isSavingPhotos)" @onclick="() => MovePhotoAsync(current, 1)"><i class="bi bi-arrow-down"></i></button>
                            <button type="button" title="Verwijderen" disabled="@isSavingPhotos" @onclick="() => RemovePhotoAsync(photoId)"><i class="bi bi-x-lg"></i></button>
                        </li>
                    }
                </ol>
            }
            @if (photoIds.Count < ApplicationConfiguration.MaxPhotos)
            {
                <label>Foto's toevoegen</label>
                <InputFile OnChange="OnPhotosChangeAsync" accept="image/png,image/jpeg,image/webp" multiple disabled="@isSavingPhotos" />
            }
        </div>
    </div>

    <link rel="stylesheet" href="/css/signup-component.css" />
    <div class="signup-container @(showInformPrompt ? "container-visible" : "")">
        <div class="form">
            <section>
                <label>Deelnemers informeren</label>
                <p>De activiteit is opgeslagen. Wil je alle deelnemers een e-mail sturen met de actuele datum, tijd en locatie?</p>
            </section>
            <section>
                <button type="button" @onclick="InformParticipantsAsync" disabled="@isInforming">
                    @(!isInforming ? "Deelnemers informeren" : "Aan het laden..")
                </button>
            </section>
            <section>
                <button type="button" @onclick="SkipInformParticipants" disabled="@isInforming">Overslaan</button>
            </section>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    EditActivityRequest request = new EditActivityRequest();
    ActivityDetailResponse? activity = null;
    EditContext? context = null;
    List<Guid> photoIds = [];
    bool isSavingPhotos = false;
    ComponentRequest<EditActivityRequest>? form = null;
    ValidationMessageStore? dateMessages = null;
    Dictionary<string, string> typedDates = [];
    bool isEditing = false;
    bool isLoading = true;
    bool showInformPrompt = false;
    bool isInforming = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        if (AuthenticationState is null)
            return;

        AuthenticationState state = await AuthenticationState;
        if (!state.User.IsInRole("Admin") || string.IsNullOrWhiteSpace(Id))
        {
            NavigationManager.NavigateTo("/activiteiten");
            return;
        }

        ApiResponse<ActivityDetailResponse> activityResponse = await ActivityService.GetDetailAsync(Id);
        if (!activityResponse.Succeeded || activityResponse.Value is null)
        {
            Notifications.AddNotification(activityResponse.Message, true);
            NavigationManager.NavigateTo($"/activiteit/{activity?.Slug ?? Id}");
            isLoading = false;
            return;
        }

        activity = activityResponse.Value;
        photoIds = activity.PhotoIds;
        request = activity.ToEditActivityRequest();
        form = new ComponentRequest<EditActivityRequest>(request);
        context = form.Context;
        dateMessages = new ValidationMessageStore(context);
        isLoading = false;
    }

    public void OnDateChange(ChangeEventArgs args, Expression<Func<EditActivityRequest, DateTime>> selector)
    {
        if (selector.Body is not MemberExpression expression || expression.Member is not PropertyInfo property || context is null || dateMessages is null)
            return;

        string text = args.Value?.ToString() ?? string.Empty;
        FieldIdentifier field = new FieldIdentifier(request, property.Name);
        dateMessages.Clear(field);

        if (DateExtensions.TryParseInput(text, out DateTime date))
        {
            typedDates.Remove(property.Name);
            property.SetValue(request, DateTime.SpecifyKind(date, DateTimeKind.Local).ToUniversalTime());
        }
        else
        {
            typedDates[property.Name] = text;
            property.SetValue(request, DateTime.MinValue);

            if (!string.IsNullOrWhiteSpace(text))
                dateMessages.Add(field, "Deze datum kan niet gelezen worden. Typ bijvoorbeeld 12-10-2026 19:30.");
        }

        context.NotifyFieldChanged(field);
        context.NotifyValidationStateChanged();
    }

    public string GetDateValue(Expression<Func<EditActivityRequest, DateTime>> selector)
    {
        if (selector.Body is MemberExpression expression && typedDates.TryGetValue(expression.Member.Name, out string? text))
            return text;

        DateTime date = selector.Compile()(request);
        return date == DateTime.MinValue ? string.Empty : date.ToDisplayDateTime();
    }

    public async Task EditAsync()
    {
        isEditing = true;

        foreach (PropertyInfo property in typeof(EditActivityRequest).GetProperties())
        {
            object? value = property.GetValue(request);
            if (property.PropertyType == typeof(decimal?))
                property.SetValue(request, value ?? 0.0m);

            if (property.PropertyType == typeof(int?))
                property.SetValue(request, value ?? 0);
        }

        ApiResponse<object> response = await ActivityService.EditAsync(request);
        if (!response.Succeeded)
        {
            form?.ShowErrors(response);
            isEditing = false;
            return;
        }

        Notifications.AddNotification("De activiteit is met succes bijgewerkt.", false);
        isEditing = false;
        showInformPrompt = true;
    }

    public async Task InformParticipantsAsync()
    {
        isInforming = true;

        ApiResponse<InformParticipantsResponse> response = await ActivityService.InformParticipantsAsync(activity?.Id ?? Guid.Empty);
        if (!response.Succeeded || response.Value is null)
        {
            Notifications.AddNotification(response.Message, true);
            isInforming = false;
            return;
        }

        InformParticipantsResponse result = response.Value;
        if (result.FailedParticipants > 0)
            Notifications.AddNotification($"{result.InformedParticipants} van de {result.TotalParticipants} deelnemers zijn geïnformeerd. Bij {result.FailedParticipants} deelnemers kon de e-mail niet worden verstuurd.", true, 6000);
        else if (result.TotalParticipants == 0)
            Notifications.AddNotification("Er zijn geen deelnemers om te informeren.", false);
        else
            Notifications.AddNotification($"{result.InformedParticipants} deelnemers zijn geïnformeerd.", false);

        isInforming = false;
        showInformPrompt = false;
        NavigationManager.NavigateTo($"/activiteit/{Id}");
    }

    public void SkipInformParticipants()
    {
        showInformPrompt = false;
        NavigationManager.NavigateTo($"/activiteit/{Id}");
    }

    public async Task OnPhotosChangeAsync(InputFileChangeEventArgs args)
    {
        int maxPhotos = ApplicationConfiguration.MaxPhotos - photoIds.Count;
        if (args.FileCount > maxPhotos)
        {
            Notifications.AddNotification($"Je kunt nog maximaal {maxPhotos} foto's toevoegen.", true);
            return;
        }

        List<IBrowserFile> photos = args.GetMultipleFiles(maxPhotos).ToList();
        if (photos.Sum(x => x.Size) > ApplicationConfiguration.AllowedSizeInMB)
        {
            Notifications.AddNotification($"De foto's zijn samen groter dan {ApplicationConfiguration.AllowedSizeInMB / 1024 / 1024} MB. Kies minder of kleinere foto's.", true);
            return;
        }

        isSavingPhotos = true;

        ApiResponse<object> response = await ActivityService.AddPhotosAsync(activity?.Id ?? Guid.Empty, new AddActivityPhotosRequest() { Photos = photos });
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isSavingPhotos = false;
            return;
        }

        await ReloadPhotosAsync();
        Notifications.AddNotification("De foto's zijn met succes toegevoegd.", false);
        isSavingPhotos = false;
    }

    public async Task MovePhotoAsync(int index, int step)
    {
        List<Guid> order = photoIds.ToList();
        (order[index], order[index + step]) = (order[index + step], order[index]);

        isSavingPhotos = true;

        ApiResponse<object> response = await ActivityService.UpdatePhotoOrderAsync(activity?.Id ?? Guid.Empty, new UpdateActivityPhotoOrderRequest() { PhotoIds = order });
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isSavingPhotos = false;
            return;
        }

        photoIds = order;
        isSavingPhotos = false;
    }

    public async Task RemovePhotoAsync(Guid photoId)
    {
        isSavingPhotos = true;

        ApiResponse<object> response = await ActivityService.DeletePhotoAsync(activity?.Id ?? Guid.Empty, photoId);
        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isSavingPhotos = false;
            return;
        }

        photoIds.Remove(photoId);
        Notifications.AddNotification("De foto is met succes verwijderd.", false);
        isSavingPhotos = false;
    }

    private async Task ReloadPhotosAsync()
    {
        ApiResponse<ActivityDetailResponse> response = await ActivityService.GetDetailAsync(Id);
        if (!response.Succeeded || response.Value is null)
        {
            Notifications.AddNotification(response.Message, true);
            return;
        }

        photoIds = response.Value.PhotoIds;
    }
}