@inject ISignUpService SignUpService

@if (ShouldDisplay)
{
    <div class="signup-container" @onclick="CloseAsync">
        <EditForm Model="Request" OnValidSubmit="OnSubmitAsync" class="form" @onclick:stopPropagation="true">
            @if (User?.Identity?.IsAuthenticated == false)
            {
                <section>
                    <label>Email</label>
                    <InputText @bind-Value="Request.Email" />
                </section>
            }
            @if (PlusOneAllowed)
            {
                <section>
                    <label>Zou je een +1 willen meenemen?</label>
                    <label class="switch">
                        <InputCheckbox @bind-Value="Request.HasPlusOne" />
                        <span class="slider round"></span>
                    </label>
                </section>
            }
            <section>
                <button type="submit">Inschrijven wijzigen</button>
            </section>
        </EditForm>
    </div>
}

@code {
    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    private ClaimsPrincipal? User { get; set; }

    [Parameter] public required EventCallback<EditSignUpRequest> RequestChanged { get; set; }
    [Parameter] public required EventCallback<bool> ShouldDisplayChanged { get; set; }
    [Parameter] public required EventCallback OnSubmit { get; set; }
    [Parameter] public required EditSignUpRequest Request { get; set; }
    [Parameter] public required bool PlusOneAllowed { get; set; }
    [Parameter] public required bool ShouldDisplay { get; set; }

    private bool IsDisplayed = false;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null)
            return;

        AuthenticationState state = await AuthenticationState;
        User = state.User;

        if (!ShouldDisplay || IsDisplayed)
            return;

        IsDisplayed = true;
        ApiResponse<SignUpDTO> response = await SignUpService.GetSignUpAsync(new GetSignUpRequest() { ActivityId = Request.ActivityId });
        if (!response.Succeeded || response.Value is null)
            return;

        SignUpDTO signUp = response.Value;
        Request.HasPlusOne = signUp.HasPlusOne;
        await RequestChanged.InvokeAsync(Request);
    }

    public async Task OnSubmitAsync()
    {
        IsDisplayed = false;
        await RequestChanged.InvokeAsync(Request);
        await OnSubmit.InvokeAsync();
    }

    public async Task CloseAsync()
    {
        IsDisplayed = false;
        ShouldDisplay = false;
        await ShouldDisplayChanged.InvokeAsync(ShouldDisplay);
    }
}
