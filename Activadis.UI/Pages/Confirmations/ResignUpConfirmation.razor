@inject IActivityService ActivityService
@inject ISignUpService SignUpService
@page "/confirm-resignup/{Token}"

<div class="container">
    @if (isLoading)
    {
        <div class="spinner-border" role="status"></div>
    }
    else
    {
        <div class="small-container">
            @if (response.Succeeded)
            {
                <i class="bi bi-check-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-x-circle-fill"></i>
            }
            <p>@response.Message</p>
        </div>
    }
</div>
<ResignUpComponent OnSubmit="OnSubmitAsync" @bind-Request="request" PlusOneAllowed="activity.PlusOneAllowed" />

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private ComponentRequest<ResignUpRequest> request = new ComponentRequest<ResignUpRequest>(new ResignUpRequest());
    private ActivityDetailResponse activity = new ActivityDetailResponse();
    private ApiResponse<object> response = new ApiResponse<object>();
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        ApiResponse<ResignUpRequest> resignUpResponse = await SignUpService.GetResignUpRequestAsync(Token);
        if (!resignUpResponse.Succeeded || resignUpResponse.Value is null)
        {
            response.Succeeded = false;
            response.Message = resignUpResponse.Message;
            isLoading = false;
            return;
        }

        request.Request = resignUpResponse.Value;
        ApiResponse<ActivityDetailResponse> activityResponse = await ActivityService.GetDetailAsync(request.Request.ActivityId.ToString());
        if (!activityResponse.Succeeded || activityResponse.Value is null)
        {
            response.Succeeded = false;
            response.Message = activityResponse.Message;
            isLoading = false;
            return;
        }

        activity = activityResponse.Value;
        request.ShouldOpenComponent = true;
    }

    public async Task OnSubmitAsync()
    {
        request.ShouldOpenComponent = false;
        response = await SignUpService.ResignUpRequestAsync(Token, request.Request);
        if (!response.Succeeded)
        {
            request.ShouldOpenComponent = true;
            return;
        }

        isLoading = false;
    }
}
