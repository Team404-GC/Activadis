@page "/"
@inject NavigationManager Navigation

<PageTitle>Activadis</PageTitle>


<section class="hm-hero">
    <div class="hm-logo">
        <LogoAnimation />
    </div>
    <div class="hm-intro">
        <h1>Activadis</h1>
        <p class="hm-lead">
            Alle activiteiten van Covadis op een plek. Bekijk wat er op de planning staat,
            schrijf je in en houd bij waar je bij bent.
        </p>

        <a class="hm-button" href="/login">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Inloggen</span>
        </a>

        <p class="hm-note">Log in om alle activiteiten te zien en je in te schrijven.</p>
    </div>
</section>

<section class="hm-blocks">
    <a class="hm-block" href="/open-haard">
        @* <h2>De haard</h2> *@
        <video autoplay muted loop>
            <source src="videos/OPEN_HAARD.mp4" type="video/mp4" />
        </video>
    </a>

    <div class="hm-placeholder">
        <h2>Animatie</h2>
        <p>Deze plek is gereserveerd voor de animatie.</p>
    </div>
</section>


@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState;

        if (state.User.Identity?.IsAuthenticated != true)
            return;

        Navigation.NavigateTo("/activiteiten");
    }
}