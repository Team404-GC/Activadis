@page "/"
@inject NavigationManager Navigation
@inject IActivityService ActivityService

<PageTitle>Activadis</PageTitle>

<section class="hm-hero">
    <div class="hm-logo">
        <LogoAnimation />
        <SeasonTvComponent Season="@Season" />
    </div>
    <div class="hm-intro">
        <h1>Activadis</h1>
        <p class="hm-lead">
            Alle activiteiten van Covadis op een plek. Bekijk wat er op de planning staat,
            schrijf je in en houd bij waar je bij bent.
        </p>

        <p class="hm-note">Log in om alle activiteiten te zien en je in te schrijven.</p>
    </div>
</section>

<section class="hm-blocks">
    <ListOverviewComponent Activities="activities"
    EmptyMessage="Geen activiteiten beschikbaar." />
</section>


@code {
    [SupplyParameterFromQuery(Name = "seizoen")]
    public string? Season { get; set; }

    private IEnumerable<ActivityOverviewResponse> activities = [];

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {

        AuthenticationState state = await AuthState;

        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/activiteiten", replace: true);
            return;
        }

        ApiResponse<IEnumerable<ActivityOverviewResponse>> response = await ActivityService.GetActivitiesAsync(new ActivityFilterRequest()
        {
             ExcludeInternal = true
        });

        if (response.Succeeded)
            activities = response.Value ?? [];

    }
}