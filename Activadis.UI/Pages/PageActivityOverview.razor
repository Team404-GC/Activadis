@inject IActivityService ActivityService
@attribute [Authorize]
@page "/activiteiten"

<PageTitle>Activiteiten</PageTitle>

<h1>Activiteiten</h1>

<div class="ao-toolbar">
    <nav class="ao-tabs">
        <button type="button" class="ao-tab @(showMine ? "" : "active")" @onclick="@(() => SelectTabAsync(false))">Alle activiteiten</button>
        <button type="button" class="ao-tab @(showMine ? "active" : "")" @onclick="@(() => SelectTabAsync(true))">Mijn activiteiten</button>
    </nav>

    @if (!showMine)
    {
        <div class="ao-filters">
            <input class="ao-input" type="search" placeholder="Zoek op naam" @bind="name" @bind:after="LoadAsync" />
            <input class="ao-input" type="date" @bind="date" @bind:after="LoadAsync" />
            <input class="ao-input" type="time" @bind="time" @bind:after="LoadAsync" disabled="@(date is null)" />

            @if (isAdmin)
            {
                <button type="button" class="ao-filter @(showPast ? "active" : "")" @onclick="TogglePastActivitiesAsync">
                    <i class="bi bi-clock-history"></i>
                    <span>Toon afgelopen</span>
                </button>
            }
        </div>
    }
</div>

@if (isLoading)
{
    <div class="ao-state">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <ListOverviewComponent Activities="activities"
                           EmptyMessage="@(showMine ? "Je bent nog niet ingeschreven voor een activiteit." : "Er zijn op dit moment geen activiteiten.")" />
}

@code {
    private IEnumerable<ActivityOverviewResponse> activities = [];
    private bool isLoading = true;
    private bool showMine = false;
    private bool showPast = false;

    private string? name;
    private DateTime? date;
    private TimeOnly? time;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState;
        isAdmin = state.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task SelectTabAsync(bool mine)
    {
        if (showMine == mine)
            return;

        showMine = mine;
        await LoadAsync();
    }

    private async Task TogglePastActivitiesAsync()
    {
        showPast = !showPast;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        activities = [];

        ApiResponse<IEnumerable<ActivityOverviewResponse>> response = showMine
            ? await ActivityService.GetSignedUpAsync()
            : await ActivityService.GetActivitiesAsync(BuildFilter());

        if (!response.Succeeded)
        {
            Notifications.AddNotification(response.Message, true);
            isLoading = false;
            return;
        }

        activities = response.Value ?? [];
        isLoading = false;
    }

    private ActivityFilterRequest BuildFilter()
    {
        ActivityFilterRequest filter = new ActivityFilterRequest()
        {
            Name = string.IsNullOrWhiteSpace(name) ? null : name.Trim(),
            IncludePast = isAdmin && showPast
        };

        if (date is DateTime day)
        {
            DateTime from = time is TimeOnly moment ? day.Date.Add(moment.ToTimeSpan()) : day.Date;
            DateTime to = time is null ? day.Date.AddDays(1).AddTicks(-1) : from;

            filter.From = DateTime.SpecifyKind(from, DateTimeKind.Local).ToUniversalTime();
            filter.To = DateTime.SpecifyKind(to, DateTimeKind.Local).ToUniversalTime();
        }

        return filter;
    }
}